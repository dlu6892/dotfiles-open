# Copy to .env (gitignored) and fill in.
# Used by: install.sh (bootstrap) and `make identity` (re-apply any time).
#
# make identity writes:
#   ~/.gitconfig        ← open account identity (global default)
#   ~/.gitconfig.work   ← work account identity (scoped to .ghq/github.com-work/)

# Open account (github.com / id_ed25519_dlu6892)
DOTFILES_GIT_NAME=
DOTFILES_GIT_EMAIL=

# Work account (github.com-work / id_ed25519) — leave unset to skip
WORK_GIT_NAME=
WORK_GIT_EMAIL=
